{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Editorial articles for REBEL AFRIQUE"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 100 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text", "maxLength": 200 },
    "content": { "type": "blocks" },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "featured": { "type": "boolean", "default": false },
    "readingTime": { "type": "integer", "min": 1 },
    "scheduledPublishAt": {
      "type": "datetime",
      "description": "When set on a draft, a cron job publishes the article at this time"
    },
    "seoTitle": { "type": "string", "maxLength": 70 },
    "seoDescription": { "type": "text", "maxLength": 160 },
    "socialImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "canonicalUrl": { "type": "string" },
    "source": {
      "type": "string",
      "maxLength": 120,
      "description": "News outlet or wire attribution shown under the byline"
    },
    "sourceUrl": {
      "type": "string",
      "description": "Optional link for the news source"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "articles"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "articles"
    },
    "relatedArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article"
    }
  },
  "indexes": [
    {
      "name": "articles_featured_idx",
      "columns": ["featured"],
      "type": null
    },
    {
      "name": "articles_published_at_idx",
      "columns": ["published_at"],
      "type": null
    }
  ]
}
