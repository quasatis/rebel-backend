{
  "kind": "collectionType",
  "collectionName": "shows",
  "info": {
    "singularName": "show",
    "pluralName": "shows",
    "displayName": "Show"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "text" },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "featured": { "type": "boolean", "default": false },
    "episodes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::show-episode.show-episode",
      "mappedBy": "show"
    }
  },
  "indexes": [
    {
      "name": "shows_featured_idx",
      "columns": ["featured"],
      "type": null
    }
  ]
}
