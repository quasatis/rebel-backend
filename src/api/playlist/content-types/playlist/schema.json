{
  "kind": "collectionType",
  "collectionName": "playlists",
  "info": {
    "singularName": "playlist",
    "pluralName": "playlists",
    "displayName": "Playlist"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 100 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "text", "maxLength": 2000 },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "mediaSource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::media-source.media-source"
    },
    "youtubeSource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::youtube-source.youtube-source"
    },
    "vimeoSource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::media-source.media-source"
    },
    "spotifySource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::media-source.media-source"
    },
    "artist": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::artist.artist"
    },
    "featured": { "type": "boolean", "default": false },
    "displayOrder": { "type": "integer", "default": 1, "min": 1 },
    "active": { "type": "boolean", "default": true }
  }
}
