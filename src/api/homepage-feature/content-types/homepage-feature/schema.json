{
  "kind": "collectionType",
  "collectionName": "homepage_features",
  "info": {
    "singularName": "homepage-feature",
    "pluralName": "homepage-features",
    "displayName": "Homepage Feature"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "contentType": {
      "type": "enumeration",
      "enum": ["article", "studio-video", "music-release", "event", "show"],
      "required": true
    },
    "headline": { "type": "string", "maxLength": 100 },
    "description": { "type": "text", "maxLength": 200 },
    "ctaLabel": { "type": "string", "maxLength": 40 },
    "ctaUrl": { "type": "string" },
    "categoryLabel": { "type": "string", "maxLength": 80 },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "position": { "type": "integer", "default": 0 },
    "priority": { "type": "integer", "default": 0 },
    "startDate": { "type": "datetime" },
    "endDate": { "type": "datetime" },
    "active": { "type": "boolean", "default": true },
    "article": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article.article"
    },
    "studioVideo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::studio-video.studio-video"
    },
    "musicRelease": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::music-release.music-release"
    },
    "event": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::event.event"
    },
    "show": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::show.show"
    }
  }
}
