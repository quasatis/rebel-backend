{
  "kind": "collectionType",
  "collectionName": "artists",
  "info": {
    "singularName": "artist",
    "pluralName": "artists",
    "displayName": "Artist"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "biography": { "type": "text" },
    "profileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "genres": { "type": "json" },
    "socialLinks": { "type": "json" },
    "featured": { "type": "boolean", "default": false },
    "releases": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::music-release.music-release",
      "mappedBy": "artist"
    }
  }
}
