{
  "kind": "collectionType",
  "collectionName": "studio_videos",
  "info": {
    "singularName": "studio-video",
    "pluralName": "studio-videos",
    "displayName": "Studio Video"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 100 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "text", "maxLength": 2000 },
    "mediaSource": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::media-source.media-source"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "durationSeconds": { "type": "integer" },
    "releaseDate": { "type": "datetime" },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category"
    },
    "featured": { "type": "boolean", "default": false },
    "genre": {
      "type": "enumeration",
      "enum": ["music", "film", "documentary", "interview", "live"]
    },
    "studioGenres": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::studio-genre.studio-genre",
      "inversedBy": "videos"
    },
    "isOriginal": { "type": "boolean", "default": false },
    "visibility": {
      "type": "enumeration",
      "enum": ["public", "unlisted", "private"],
      "default": "public"
    },
    "sortOrder": { "type": "integer", "default": 0 }
  },
  "indexes": [
    {
      "name": "studio_videos_featured_idx",
      "columns": ["featured"],
      "type": null
    },
    {
      "name": "studio_videos_genre_idx",
      "columns": ["genre"],
      "type": null
    },
    {
      "name": "studio_videos_is_original_idx",
      "columns": ["is_original"],
      "type": null
    }
  ]
}
