# Server
HOST=0.0.0.0
PORT=1337

# Database (MySQL)
DATABASE_CLIENT=mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=rebelafrique
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
# Optional pool / timeout overrides (used by config/database.ts)
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# Strapi secrets (generate unique values for production)
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
# HMAC secret for draft preview links (falls back to the first APP_KEYS entry if unset)
PREVIEW_SECRET=tobemodified-preview-secret
# AES key for encrypting TOTP secrets at rest (falls back to the first APP_KEYS entry if unset)
MFA_ENCRYPTION_KEY=tobemodified-mfa-encryption-key

# Integrations
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
# Optional: Cloudinary upload timeout in ms (default 120000)
CLOUDINARY_TIMEOUT_MS=120000
YOUTUBE_API_KEY=
# Cron expression for YouTube sync (default: top of every hour)
YOUTUBE_SYNC_CRON=0 * * * *
NETLIFY_BUILD_HOOK_URL=
# Debounce multiple publish events into one Netlify rebuild (ms)
NETLIFY_BUILD_DEBOUNCE_MS=15000

# Contact form + transactional email.
# Priority: BREVO_API_KEY (Brevo Transactional API) → SMTP_* (nodemailer) → sendmail default.
# Without either Brevo or SMTP, messages are stored but not emailed.
# After changing email packages/providers, rebuild the Strapi image:
#   docker compose up -d --build strapi
CONTACT_TO=rebelafriqueapp@gmail.com
CONTACT_FROM=rebelafriqueapp@gmail.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=REBEL AFRIQUE
# Public backoffice origin for invite magic links and MFA-related emails (no trailing slash)
BACKOFFICE_URL=http://localhost:3001
# Public frontoffice origin for newsletter unsubscribe links (no trailing slash)
FRONTOFFICE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Seed demo editorial content once on first boot (set FORCE_SEED_DEMO_CONTENT=true to re-run).
# Existing CMS edits are never overwritten; deleted seed rows are not recreated after the first run.
SEED_DEMO_CONTENT=true

# CORS (comma-separated origins). Include alternate local Nuxt ports.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
