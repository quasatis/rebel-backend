{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.js",
    "./config/**/*.ts",
    "./database/**/*.ts",
    "./src/**/*.json"
  ],
  "exclude": [
    "node_modules/",
    "build/",
    "dist/",
    ".cache/",
    ".tmp/",
    "src/admin/",
    "src/plugins/**",
    "types/generated/",
    "**/*.test.*"
  ]
}
